      "auth": {
        "type": "actions_secret",
        "ref": "FEISHU_APP_TOKEN",
        "headerName": "Authorization",
        "scheme": "Bearer",
        "note": "CI 中由 ${{ secrets.FEISHU_APP_TOKEN }} 注入；本地由 .env 注入；仓库内只存引用名，绝不放明文"
      },
      "fieldMapping": {
        "mode": "table",
        "map": {
          "title": "标题",
          "url": "链接",
          "publishedAt": "发布时间",
          "summary": "摘要",
          "author": "作者",
          "tags": "标签"
        },
        "typeCoercion": { "publishedAt": "date", "tags": "array" }
      },
      "pagination": { "strategy": "cursor", "cursorParam": "page_token", "pageSizeParam": "page_size", "pageSize": 100, "cursorPath": "$.data.page_token", "maxPages": 20 },
      "createdAt": "2026-09-05T02:00:00Z",
      "updatedAt": "2026-09-05T02:00:00Z",
      "notes": "飞书多维表格接入示例"
