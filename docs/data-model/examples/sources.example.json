      "channelId": "my-feishu-sources",
      "name": "飞书源表（app_token + table_id）",
      "type": "feishu_bitable",
      "url": "https://open.feishu.cn/open-apis/bitable/v1/apps/FLYER_APP_TOKEN/tables/tblXXXXXXXX/records",
