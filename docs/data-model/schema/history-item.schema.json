{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rss-radar.dev/schema/history-item.schema.json",
  "title": "RSS Radar 历史条目行 (history/YYYY/MM/items.ndjson 的单行)",
  "description": "月度 NDJSON 的一行 = 一个精简历史 Item。行级校验：对每一行 parse 出的对象套用本 schema。跨行约束(如所有行 date 一致)由 scripts/validate-schema.mjs 断言。完整字段(含 summary/sources)请读该天的 snapshot-<date>.json。",
  "type": "object",
  "required": ["id", "dedupKey", "title", "url", "channelId", "channelName", "category", "publishedAt", "updatedAt", "date"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "description": "条目 id (it_ + 12 hex)", "examples": ["it_9f2c1a7b3e5d"] },
    "dedupKey": { "type": "string", "description": "去重键 sha256 hex(跨天去重用)", "examples": ["8f0c1d2e9a4b6c3f"] },
    "title": { "type": "string", "maxLength": 512, "description": "标题" },
    "url": { "type": "string", "description": "原文链接" },
    "channelId": { "type": "string", "description": "所属渠道 id" },
    "channelName": { "type": "string", "description": "渠道名(冗余)" },
    "category": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "分类(多标签)" },
    "publishedAt": { "type": "string", "format": "date-time", "description": "发布时间(ISO 8601 UTC)" },
    "updatedAt": { "type": "string", "format": "date-time", "description": "更新时间(ISO 8601 UTC)" },
    "sourceCount": { "type": "integer", "minimum": 1, "default": 1, "description": "归并的源数量(≥1)" },
    "hotScore": { "type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "热度分(0~1)" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "归属自然日(Asia/Shanghai)，与文件名年月对应", "examples": ["2026-09-12"] }
  }
}
