{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rss-radar.dev/schema/notify.schema.json",
  "title": "RSS Radar 通知配置 (config/notify.json)",
  "description": "邮箱/飞书/钉钉/企业微信四类通知渠道；每日报告推送 + 实时结果总结推送。密钥只存引用名(refs)，值走 GitHub Secrets，配置文件内绝无明文。",
  "type": "object",
  "required": ["schemaVersion", "channels"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+$", "examples": ["1.0"] },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timezone": { "type": "string", "default": "Asia/Shanghai" },
        "dailyReportTime": { "type": "string", "pattern": "^\\d{2}:\\d{2}$", "default": "08:00", "description": "默认每日推送时间(本地时区)" },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max": { "type": "integer", "minimum": 0, "default": 2 },
            "backoffMs": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "default": [1000, 3000] }
          }
        }
      }
    },
    "channels": {
      "type": "array",
      "items": { "$ref": "#/definitions/channel" }
    },
    "realtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "hotScoreThreshold": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.8 },
        "sourceCountThreshold": { "type": "integer", "minimum": 1, "default": 3 },
        "maxPerDay": { "type": "integer", "minimum": 0, "default": 10 }
      }
    },
    "quietHours": { "type": "string", "pattern": "^\\d{2}:\\d{2}-\\d{2}:\\d{2}$", "default": "23:00-07:00", "description": "免打扰时段(实时推送静默, 合并到次日日报)" }
  },
  "definitions": {
    "refs": {
      "type": "object",
      "description": "密钥引用名映射：{逻辑密钥名: GitHub Secrets 变量名}；值不入库",
      "additionalProperties": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
      "examples": [{ "password": "SMTP_PASSWORD", "webhook": "FEISHU_WEBHOOK" }]
    },
    "channel": {
      "type": "object",
      "required": ["id", "channelType", "enabled", "events", "refs"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "examples": ["email-main"] },
        "channelType": { "type": "string", "enum": ["email", "feishu", "dingtalk", "wecom"], "description": "渠道类型(选适配器)" },
        "enabled": { "type": "boolean" },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["dailyReport", "realtime"] },
          "description": "订阅的推送事件"
        },
        "refs": { "$ref": "#/definitions/refs" },
        "smtpHost": { "type": "string", "description": "邮箱渠道必填" },
        "smtpPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "secure": { "type": "boolean", "default": true },
        "from": { "type": "string", "description": "发件人(邮箱渠道)" },
        "to": { "type": "array", "items": { "type": "string" }, "description": "收件人列表(邮箱渠道)" },
        "webhookRef": { "type": "string", "description": "群机器人 webhook 引用名(飞书/钉钉/企业微信)" },
        "signSecretRef": { "type": "string", "description": "加签密钥引用名(钉钉/飞书启用签名校验时)" },
        "corpId": { "type": "string", "description": "企业微信应用消息 corpId" },
        "agentId": { "type": "string", "description": "企业微信应用消息 agentId" },
        "toUser": { "type": "string", "description": "企业微信应用消息接收人" },
        "toParty": { "type": "string", "description": "企业微信应用消息接收部门" },
        "quietHours": { "type": "string", "description": "该渠道的免打扰时段(覆盖全局)" },
        "severity": { "type": "string", "enum": ["info", "warn", "critical"], "description": "最低推送级别" }
      },
      "allOf": [
        {
          "if": { "properties": { "channelType": { "const": "email" } }, "required": ["channelType"] },
          "then": { "required": ["smtpHost", "smtpPort", "from", "to"], "properties": { "refs": { "type": "object", "required": ["password"] } } }
        },
        {
          "if": { "properties": { "channelType": { "enum": ["feishu", "dingtalk", "wecom"] } }, "required": ["channelType"] },
          "then": { "required": ["webhookRef"] }
        }
      ]
    }
  }
}
