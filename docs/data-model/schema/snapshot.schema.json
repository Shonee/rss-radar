{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rss-radar.dev/schema/snapshot.schema.json",
  "title": "RSS Radar 当日快照 (snapshot-YYYY-MM-DD.json)",
  "description": "某个自然日(Asia/Shanghai)内所有 Channel/Item 的汇总数据文件。当天持续被覆盖更新，次日新建。去重后的最终落盘产物。主格式 JSON，辅格式 CSV 字段映射见 docs/data-model/README.md。",
  "type": "object",
  "required": ["schemaVersion", "date", "timezone", "generatedAt", "stats", "items"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+$", "examples": ["1.0"] },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "快照所属自然日(以 timezone 切日)", "examples": ["2026-09-12"] },
    "timezone": { "type": "string", "const": "Asia/Shanghai", "description": "切日时区，固定 Asia/Shanghai(UTC+8)" },
    "generatedAt": { "type": "string", "format": "date-time", "description": "本次快照生成时间(ISO 8601 UTC)", "examples": ["2026-09-12T09:30:12Z"] },
    "reportPath": { "type": "string", "pattern": "^today/report-\\d{4}-\\d{2}-\\d{2}-\\d{4}\\.json$", "description": "同轮次报告文件路径(相对 data/，形如 today/report-<date>-<stamp>.json)。可选字段：2026-09-16 起快照自带此声明，使消费者无需按命名规则『反推』报告名。报告名带 4 位 UTC 后缀后，任何拼 `report-<date>.json` 固定名的写法都会失效(404 或静默命中同名陈旧文件)。旧快照可缺省。", "examples": ["today/report-2026-09-12-0930.json"] },
    "stats": { "$ref": "#/definitions/stats" },
    "items": {
      "type": "array",
      "description": "去重后的条目列表(主条目；被合并条目通过 duplicateOf 指向主条目，默认不单独占行，或按配置保留)",
      "items": { "$ref": "#/definitions/item" }
    }
  },
  "definitions": {
    "stats": {
      "type": "object",
      "required": ["sourceTotal", "sourceOk", "sourceFailed", "itemsBeforeDedup", "itemsAfterDedup"],
      "additionalProperties": true,
      "properties": {
        "sourceTotal": { "type": "integer", "minimum": 0, "description": "参与采集的源总数" },
        "sourceOk": { "type": "integer", "minimum": 0, "description": "抓取成功的源数" },
        "sourceFailed": { "type": "integer", "minimum": 0, "description": "抓取失败的源数" },
        "itemsBeforeDedup": { "type": "integer", "minimum": 0, "description": "去重前条目数" },
        "itemsAfterDedup": { "type": "integer", "minimum": 0, "description": "去重后条目数" },
        "mergedCount": { "type": "integer", "minimum": 0, "description": "被归并(重复)的条目数" },
        "durationMs": { "type": "integer", "minimum": 0, "description": "本次采集耗时(毫秒)" },
        "sourceHealth": {
          "type": "array",
          "description": "逐源抓取健康度(T-P3-fix 新增)。语义:参与采集的每个 source 一条记录。与 stats.sources[](条目归并后的渠道分布)是两个维度,勿混用;页面1「本次抓取失败 N 个渠道」黄条据此列出失败渠道名。sourceTotal/sourceOk/sourceFailed 即由本数组汇总得出。",
          "items": {
            "type": "object",
            "required": ["sourceId", "channelId", "channelName", "ok"],
            "additionalProperties": false,
            "properties": {
              "sourceId": { "type": "string", "description": "源 id(外键,对应 sources.json 的 sources[].id)" },
              "channelId": { "type": "string", "description": "所属渠道 id(外键)" },
              "channelName": { "type": "string", "description": "渠道名(冗余,便于展示)" },
              "ok": { "type": "boolean", "description": "本次抓取是否成功" },
              "error": { "type": "string", "description": "失败原因(成功时缺省)" }
            }
          }
        }
      }
    },
    "item": {
      "type": "object",
      "description": "单条内容，展示/排序/去重/分析的最小单元",
      "required": ["id", "title", "url", "channelId", "channelName", "category", "publishedAt", "updatedAt", "fetchedAt", "dedupKey"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "条目唯一标识(内部生成，见 README 生成规则)", "examples": ["it_a1b2c3d4e5f6"] },
        "guid": { "type": "string", "description": "源提供的唯一 ID(RSS guid / Atom id / JSON Feed id)", "examples": ["https://www.ruanyifeng.com/blog/2026/09/weekly-001.html"] },
        "title": { "type": "string", "maxLength": 512, "description": "标题(已去 HTML、去首尾空白)" },
        "url": { "type": "string", "description": "原文链接(原始链接，非标准化)", "examples": ["https://www.ruanyifeng.com/blog/2026/09/foo.html"] },
        "urlStatus": { "type": "string", "enum": ["ok", "dead", "moved", "blocked"], "description": "URL 健康状态(v1.4 新增，见 ARCHITECTURE §15)：ok=可访问；dead=失效(404/410/域名失效)；moved=永久跳转(301/308，建议跟进新地址)；blocked=被反爬拦截(403/429，内容大概率仍存在)", "examples": ["ok"] },
        "urlCheckedAt": { "type": "string", "format": "date-time", "description": "最近一次 URL 健康检查时间(ISO 8601 UTC)；未检查过则缺省", "examples": ["2026-09-12T10:00:00Z"] },
        "summary": { "type": "string", "maxLength": 300, "description": "纯文本摘要，已去标签并截断(默认 ≤200 字符)" },
        "author": { "type": "string", "description": "作者" },
        "channelId": { "type": "string", "description": "所属渠道 id(外键)" },
        "channelName": { "type": "string", "description": "渠道名(冗余，便于展示)" },
        "category": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "分类(冗余自 Channel，多标签)" },
        "publishedAt": { "type": "string", "format": "date-time", "description": "发布/创建时间(ISO 8601 UTC)" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "更新时间(ISO 8601 UTC)" },
        "fetchedAt": { "type": "string", "format": "date-time", "description": "抓取时间(ISO 8601 UTC)，用于增量与审计" },
        "sourceUrl": { "type": "string", "description": "来源 Feed/接口地址(溯源)" },
        "sourceType": { "type": "string", "enum": ["rss", "atom", "json_feed", "local_json", "local_csv", "feishu_bitable", "notion_db", "generic_api"], "description": "来源类型。取值必须与 scripts/collect/connectors/registry.mjs 注册的 type 完全一致（generic_api 不是 api）" },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "标签/关键词" },
        "dedupKey": { "type": "string", "description": "去重键 sha256 hex(见 README 构成算法)" },
        "duplicateOf": { "type": ["string", "null"], "description": "若为重复，指向主条目 id；否则 null" },
        "sourceCount": { "type": "integer", "minimum": 1, "default": 1, "description": "归并的源数量(≥1)" },
        "sources": {
          "type": "array",
          "description": "该条目所有来源(自身 + 被归并来源)",
          "items": {
            "type": "object",
            "required": ["channelId", "channelName", "url"],
            "additionalProperties": false,
            "properties": {
              "channelId": { "type": "string" },
              "channelName": { "type": "string" },
              "url": { "type": "string" },
              "publishedAt": { "type": "string", "format": "date-time" }
            }
          }
        },
        "isNew": { "type": "boolean", "default": true, "description": "是否当天首次出现(用于 NEW 徽标)" },
        "hotScore": { "type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "热度分(0~1，由报告期计算回写或运行时计算)" },
        "language": { "type": "string", "description": "语言(BCP-47)" },
        "mediaType": { "type": "string", "enum": ["article", "video", "podcast", "release", "post", "other"], "default": "article", "description": "内容形态" }
      }
    }
  }
}
