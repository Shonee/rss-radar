{
  "name": "rss-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "把散落在各处的 RSS 源，汇聚成一份每天更新的信息雷达与热点报告。",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:node": "node --test scripts/collect/__tests__/*.test.mjs scripts/collect/__tests__/**/*.test.mjs scripts/smoke/__tests__/*.test.mjs scripts/smoke/__tests__/**/*.test.mjs src/**/__tests__/*.test.mjs",
    "test:e2e": "node scripts/smoke/e2e-pipeline.mjs",
    "smoke": "bash scripts/smoke/run.sh",
    "validate": "node scripts/validate-schema.mjs",
    "collect": "node scripts/collect/index.mjs",
    "collect:once": "node scripts/collect/index.mjs --once"
  },
  "dependencies": {
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^6.1.0",
    "@mui/material": "^6.1.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.13.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/sanitize-html": "^2.13.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}